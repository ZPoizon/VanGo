rules_version = '2';

// =============================================================================
// PROPOSTA LOCAL — NÃO PUBLICA DA.
// =============================================================================
// Funcionalidade: confirmação de ida e volta pelo aluno.
// Projeto: vango-4b4a5
//
// Este arquivo NÃO substitui `firestore.rules`. O arquivo ativo continua
// idêntico ao ruleset publicado (80877a3a-f11e-427b-8207-8c9628ca888b), que
// permite somente `get` em usuarios/{uid}.
//
// Publicar somente após aprovação explícita. Ao publicar, copiar este conteúdo
// para `firestore.rules` e executar o deploy das regras (sem Shell/índices).
//
// Estrutura adotada (baseada no código funcional):
//   usuarios/{uid}                     perfil, ativo, status, grupoId
//   chamadas/{id}                      chamada do dia (status: aberta/encerrada)
//   respostas/{chamadaId}_{alunoId}    FONTE DA VERDADE de ida/volta
//   viagens/{id}                       snapshot por sentido (confirmacoes[])
//   padroes/{uid}                      padrão semanal (próxima funcionalidade)
//
// Regras de negócio aplicadas aqui:
//   * aluno lê/escreve somente a própria resposta;
//   * gravação só enquanto a chamada estiver aberta (o motorista encerra a
//     chamada antes de iniciar a viagem, o que bloqueia alterações posteriores);
//   * perfil e ativação são lidos do próprio documento de usuário;
//   * `status` contradizendo `ativo` bloqueia o acesso;
//   * nenhuma permissão pública; demais coleções continuam negadas.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    /// Dados do próprio usuário. `get()` em regras não depende da regra de
    /// leitura do documento; a regra de acesso ao perfil permanece restrita.
    function dadosDoPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function perfilEh(nome) {
      return autenticado()
        && dadosDoPerfil().get('perfil', '').lower() == nome;
    }

    /// Perfil efetivo: exige `ativo == true` e, se `status` existir, exige que
    /// seja `ativo`. Espelha `situacaoAtivacaoDe()` do aplicativo.
    function perfilAtivoEh(nome) {
      return perfilEh(nome)
        && dadosDoPerfil().get('ativo', false) == true
        && (
          !dadosDoPerfil().keys().hasAny(['status'])
          || dadosDoPerfil().get('status', '').lower() == 'ativo'
        );
    }

    function ehAlunoAtivo() {
      return perfilAtivoEh('aluno');
    }

    function ehMotoristaAtivo() {
      return perfilAtivoEh('motorista');
    }

    function grupoPadrao() {
      return 'grupo-capao-itape';
    }

    function meuGrupo() {
      return dadosDoPerfil().get('grupoId', grupoPadrao());
    }

    function grupoDoDado(dados) {
      return dados.get('grupoId', grupoPadrao());
    }

    function mesmoGrupo(dados) {
      return grupoDoDado(dados) == meuGrupo();
    }

    // ------------------------------------------------------- próprio perfil
    // Inalterado: continua funcionando como no ruleset já publicado.
    match /usuarios/{userId} {
      allow get: if autenticado() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // ------------------------------------------------------------- chamadas
    // Leitura para o aluno ver a chamada do dia e para o motorista acompanhar.
    // Somente o motorista ativo do grupo abre/encerra a chamada — necessário
    // para o fluxo de confirmação e para bloquear respostas após a viagem.
    match /chamadas/{chamadaId} {
      allow get, list: if autenticado()
        && (ehAlunoAtivo() || ehMotoristaAtivo())
        && mesmoGrupo(resource.data);
      allow create: if ehMotoristaAtivo()
        && mesmoGrupo(request.resource.data)
        && request.resource.data.get('motoristaId', '') == request.auth.uid;
      allow update: if ehMotoristaAtivo()
        && mesmoGrupo(resource.data)
        && mesmoGrupo(request.resource.data)
        && request.resource.data.get('motoristaId', '')
          == resource.data.get('motoristaId', '');
      allow delete: if ehMotoristaAtivo() && mesmoGrupo(resource.data);
    }

    // ------------------------------------------------------------- respostas
    // ID obrigatório: "{chamadaId}_{alunoId}".
    match /respostas/{respostaId} {

      function idChamada() {
        return respostaId.split('_')[0];
      }

      function ehRespostaDoAluno() {
        return respostaId.split('_')[1] == request.auth.uid;
      }

      function chamadaDaResposta() {
        return get(/databases/$(database)/documents/chamadas/$(idChamada())).data;
      }

      /// A resposta pertence ao chamador, ao grupo dele e a uma chamada aberta
      /// do mesmo grupo. Chamada inexistente ou encerrada => nega (fail closed).
      function respostaValidaDoAluno() {
        return ehRespostaDoAluno()
          && request.resource.data.get('alunoId', '') == request.auth.uid
          && request.resource.data.get('chamadaId', '') == idChamada()
          && mesmoGrupo(request.resource.data)
          && chamadaDaResposta().get('status', '').lower() == 'aberta'
          && mesmoGrupo(chamadaDaResposta());
      }

      function sentidoValido(valor) {
        return valor in ['vai', 'naoVai', 'semResposta'];
      }

      function sentidosValidos() {
        return sentidoValido(request.resource.data.get('ida', 'semResposta'))
          && sentidoValido(request.resource.data.get('volta', 'semResposta'));
      }

      // Aluno: apenas a própria resposta. Motorista: respostas do próprio
      // grupo. As consultas do Flutter usam `chamadaId` e, para o aluno,
      // também `alunoId`, compatíveis com esta regra.
      allow get, list: if autenticado()
        && mesmoGrupo(resource.data)
        && (
          (ehAlunoAtivo()
            && resource.data.get('alunoId', '') == request.auth.uid)
          || ehMotoristaAtivo()
        );

      allow create: if ehAlunoAtivo()
        && respostaValidaDoAluno()
        && sentidosValidos()
        && request.resource.data.keys().hasOnly([
          'chamadaId', 'alunoId', 'grupoId', 'ida', 'volta', 'respondidoEm'
        ]);

      // `diff().affectedKeys()` permite preservar campos de outras fases
      // (estouIndo/liberadoEm/avisadoEm) sem ampliar o conjunto editável.
      allow update: if ehAlunoAtivo()
        && respostaValidaDoAluno()
        && sentidosValidos()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'chamadaId', 'alunoId', 'grupoId', 'ida', 'volta', 'respondidoEm'
        ]);

      allow delete: if false;
    }

    // -------------------------------------------------- demais coleções
    // viagens, padroes, convites, notificacoes, grupos, tokens etc. continuam
    // bloqueados até que cada funcionalidade tenha suas regras aprovadas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

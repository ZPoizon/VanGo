rules_version = '2';

// =============================================================================
// REGRAS DE SEGURANÇA DO FIRESTORE - VANGO
// Projeto: vango-4b4a5
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function dadosDoPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function perfilEh(nome) {
      return autenticado()
        && dadosDoPerfil().get('perfil', '').lower() == nome;
    }

    function perfilAtivoEh(nome) {
      return perfilEh(nome)
        && dadosDoPerfil().get('ativo', false) == true
        && (
          !dadosDoPerfil().keys().hasAny(['status'])
          || dadosDoPerfil().get('status', '').lower() == 'ativo'
        );
    }

    function ehAlunoAtivo() {
      return perfilAtivoEh('aluno');
    }

    function ehMotoristaAtivo() {
      return perfilAtivoEh('motorista');
    }

    function grupoPadrao() {
      return 'grupo-capao-itape';
    }

    function meuGrupo() {
      return dadosDoPerfil().get('grupoId', grupoPadrao());
    }

    function grupoDoDado(dados) {
      return dados.get('grupoId', grupoPadrao());
    }

    function mesmoGrupo(dados) {
      return grupoDoDado(dados) == meuGrupo();
    }

    // ------------------------------------------------------- usuários / perfil
    match /usuarios/{userId} {
      allow get: if autenticado()
        && (request.auth.uid == userId || (ehMotoristaAtivo() && mesmoGrupo(resource.data)));

      allow list: if ehMotoristaAtivo() && mesmoGrupo(resource.data);

      allow update: if autenticado()
        && request.auth.uid == userId
        && mesmoGrupo(resource.data)
        && mesmoGrupo(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'perfil', 'grupoId', 'ativo', 'status', 'conflitoAtivacao'
        ]);

      allow create, delete: if false;
    }

    // ------------------------------------------------------------- chamadas
    match /chamadas/{chamadaId} {
      allow get, list: if autenticado()
        && (ehAlunoAtivo() || ehMotoristaAtivo())
        && mesmoGrupo(resource.data);

      allow create: if ehMotoristaAtivo()
        && mesmoGrupo(request.resource.data)
        && request.resource.data.get('motoristaId', '') == request.auth.uid;

      allow update: if ehMotoristaAtivo()
        && mesmoGrupo(resource.data)
        && mesmoGrupo(request.resource.data)
        && request.resource.data.get('motoristaId', '') == resource.data.get('motoristaId', '');

      allow delete: if ehMotoristaAtivo() && mesmoGrupo(resource.data);
    }

    // ------------------------------------------------------------- respostas
    match /respostas/{respostaId} {

      function idChamada() {
        return respostaId.split('_')[0];
      }

      function ehRespostaDoAluno() {
        return respostaId.split('_')[1] == request.auth.uid;
      }

      function chamadaDaResposta() {
        return get(/databases/$(database)/documents/chamadas/$(idChamada())).data;
      }

      function respostaValidaDoAluno() {
        return ehRespostaDoAluno()
          && request.resource.data.get('alunoId', '') == request.auth.uid
          && request.resource.data.get('chamadaId', '') == idChamada()
          && mesmoGrupo(request.resource.data)
          && chamadaDaResposta().get('status', '').lower() == 'aberta'
          && mesmoGrupo(chamadaDaResposta());
      }

      function sentidoValido(valor) {
        return valor in ['vai', 'naoVai', 'semResposta'];
      }

      function sentidosValidos() {
        return sentidoValido(request.resource.data.get('ida', 'semResposta'))
          && sentidoValido(request.resource.data.get('volta', 'semResposta'));
      }

      allow get, list: if autenticado()
        && mesmoGrupo(resource.data)
        && (
          (ehAlunoAtivo() && resource.data.get('alunoId', '') == request.auth.uid)
          || ehMotoristaAtivo()
        );

      allow create: if ehAlunoAtivo()
        && respostaValidaDoAluno()
        && sentidosValidos()
        && request.resource.data.keys().hasOnly([
          'chamadaId', 'alunoId', 'grupoId', 'ida', 'volta', 'respondidoEm'
        ]);

      allow update: if ehAlunoAtivo()
        && respostaValidaDoAluno()
        && sentidosValidos()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'chamadaId', 'alunoId', 'grupoId', 'ida', 'volta', 'respondidoEm', 'estouIndo', 'estouIndoEm'
        ]);

      allow delete: if false;
    }

    // -------------------------------------------------- padrão semanal
    match /padroes/{userId} {
      allow get: if autenticado()
        && ((ehAlunoAtivo() && request.auth.uid == userId) || ehMotoristaAtivo())
        && mesmoGrupo(resource.data);

      allow list: if ehMotoristaAtivo() && mesmoGrupo(resource.data);

      allow create, update: if ehAlunoAtivo()
        && request.auth.uid == userId
        && mesmoGrupo(request.resource.data);

      allow delete: if false;
    }

    // ------------------------------------------------------------- viagens
    match /viagens/{viagemId} {
      allow get, list: if autenticado()
        && (ehAlunoAtivo() || ehMotoristaAtivo())
        && mesmoGrupo(resource.data);

      allow create: if ehMotoristaAtivo()
        && mesmoGrupo(request.resource.data)
        && request.resource.data.get('motoristaId', '') == request.auth.uid;

      allow update: if ehMotoristaAtivo()
        && mesmoGrupo(resource.data)
        && mesmoGrupo(request.resource.data)
        && request.resource.data.get('motoristaId', '') == resource.data.get('motoristaId', '');

      allow delete: if false;
    }

    // -------------------------------------------------- bloqueio padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
